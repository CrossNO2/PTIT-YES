# ==============================================================================
# GreenBridge v2 - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In CI/CD and production environments (Vercel, GitHub Actions), configure these
# in the environment settings dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to the browser via Next.js)
# ------------------------------------------------------------------------------
# Supabase Project HTTPS endpoint URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Public / Anonymous Key (Safe for browser usage with RLS enabled)
# Note: GreenBridge supports both modern PUBLISHABLE_KEY and standard ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Application Public Canonical URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (NEVER EXPOSE TO CLIENT / BROWSER)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses Row-Level Security)
# SECURITY NOTICE: Must NEVER be prefixed with NEXT_PUBLIC_ or committed to Git.
# Used exclusively in secure server-side API routes and administrative scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ------------------------------------------------------------------------------
# 3. LOGISTICS & ROUTING SERVICES (Optional Overrides)
# ------------------------------------------------------------------------------
# OpenStreetMap Nominatim Geocoding API endpoint
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Project OSRM Routing Engine API endpoint
OSRM_BASE_URL=https://router.project-osrm.org
